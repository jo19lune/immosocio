# ============================================================
# Variables d'environnement — Immobilier Social
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne commitez JAMAIS le fichier .env dans Git.
# ============================================================

# Base de données PostgreSQL on peut aussi utiliser MySQL/MariaDB en adaptant les propriétés
DB_URL=jdbc:postgresql://localhost:5432/immobilier_teste
DB_USERNAME=postgres
DB_PASSWORD=votre_mot_de_passe_postgres
DB_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT — secret d'au moins 64 caractères aléatoires
JWT_SECRET=remplacez_par_une_chaine_aleatoire_tres_longue_et_securisee_ici
JWT_EXPIRATION=86400000

# Multipart — upload de photos
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# SMTP (exemple Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre_adresse@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application

# URL(s) du frontend — séparées par des virgules si plusieurs origines autorisées.
# Exemples :
#   Une seule origine :  FRONTEND_URL=http://localhost:5173
#   Plusieurs origines : FRONTEND_URL=http://localhost:5173,http://localhost:4200,http://localhost:3000
#   Wildcard sous-domaine (production) : FRONTEND_URL=https://*.mondomaine.com
FRONTEND_URL=http://localhost:5173,http://localhost:4200,http://localhost:3000

# Serveur — port d'écoute du backend
SERVER_ADDRESS=0.0.0.0
PORT=8080

# Stockage local des fichiers uploadés
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=http://localhost:8080/images

# JPA (validate/none en production, update en dev)
DDL_AUTO=update
