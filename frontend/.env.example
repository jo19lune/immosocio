# ============================================================
# Variables d'environnement — Frontend ImmoSocial (Vite)
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne commitez JAMAIS le fichier .env dans Git.
# Toutes les variables VITE_ sont exposées au navigateur.
# ============================================================

# URL de base de l'API backend (sans slash final)
VITE_API_URL=http://localhost:8080/api

# URL du backend (pour WebSocket, uploads, etc.)
VITE_BACKEND_URL=http://localhost:8080
